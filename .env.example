# ─────────────────────────────────────────────────────────────
# HUZA MAJU platform: environment variables (PLACEHOLDERS ONLY)
# Copy to .env (local) or set in your hosting dashboard.
# Never commit a real .env file.
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL 15+). Managed options: Neon, Supabase, DigitalOcean, AWS RDS.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/huzamaju
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Public site URL (no trailing slash)
APP_URL=https://huzamaju.my

# Security: generate with  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Encrypts partner bank account numbers (AES-256-GCM). Generate with  openssl rand -hex 32
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# First super admin created by `npm run db:seed`
SEED_ADMIN_EMAIL=huzamaju@gmail.com
SEED_ADMIN_PASSWORD=

# ── AI (Anthropic Claude). Server-side only, never exposed to the browser ──
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TOKENS=16000
# Not sent to current Claude models (they reject temperature); kept for other providers.
AI_TEMPERATURE=0.2
# "default" lets Anthropic retry on a fallback model if the primary is overloaded; "off" to disable
AI_FALLBACKS=default
AI_DAILY_REQUEST_LIMIT=300
AI_PER_IP_HOURLY_LIMIT=6
# Used to estimate cost in the AI usage log (USD per million tokens)
AI_INPUT_USD_PER_MTOK=4
AI_OUTPUT_USD_PER_MTOK=20

# ── File storage for uploads (private) ──
# local = folder on the server (VPS); s3 = AWS S3 / Cloudflare R2 / any S3-compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ── Email (Resend). Leave EMAIL_PROVIDER=none until the domain is verified ──
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=HUZA MAJU <noreply@huzamaju.my>
ADMIN_NOTIFY_EMAIL=huzamaju@gmail.com

# ── WhatsApp Business Cloud API (optional; wa.me links work without it) ──
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_TO=60178717848

# ── Bot protection (Cloudflare Turnstile, optional but recommended) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics & Search Console ──
NEXT_PUBLIC_GA_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Official social pages, comma-separated (e.g. https://www.facebook.com/yourpage)
SOCIAL_LINKS=
